{
  "name": "@wowlab/eslint-config",
  "version": "0.1.2",
  "description": "Composable ESLint flat configs for JavaScript and TypeScript",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "deno run -A scripts/clean.ts && tsc --project tsconfig.build.json",
    "check": "pnpm check:code && pnpm docs:check",
    "check:code": "pnpm build && pnpm format:check && pnpm lint && pnpm test && pnpm typecheck",
    "docs:generate": "markupwright",
    "docs:check": "markupwright --check",
    "format": "prettier --write . && markupwright",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "package:prepare": "pnpm build && deno run -A scripts/package.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wowlabdev/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/wowlabdev/eslint-config/issues"
  },
  "homepage": "https://github.com/wowlabdev/eslint-config#readme",
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "javascript",
    "typescript"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint-react/eslint-plugin": "^5.8.6",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.2.9",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-query": "^5.100.14",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-switch-case": "^4.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "typescript-eslint": "8.68.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "@wowlab/markupwright": "^0.1.3",
    "eslint": "^10.3.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0",
    "zx": "^8.8.5"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
